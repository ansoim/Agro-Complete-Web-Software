rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return signedIn() && profile().role == 'admin' && profile().active == true;
    }
    function isActiveEmployee() {
      return signedIn() && profile().role == 'employee' && profile().active == true;
    }
    function canReadBusinessData() {
      return isAdmin() || isActiveEmployee();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && request.resource.data.salespersonId == resource.data.salespersonId);
    }
    match /salespeople/{id} {
      allow read: if canReadBusinessData();
      allow write: if isAdmin();
    }
    match /salesEntries/{id} {
      allow read: if canReadBusinessData();
      allow write: if isAdmin() || (isActiveEmployee()
        && request.resource.data.salespersonId == profile().salespersonId);
    }
    match /salesSnapshots/{id} {
      allow read: if canReadBusinessData();
      allow write: if isAdmin();
    }
    match /monthlyTargets/{id} {
      allow read: if canReadBusinessData();
      allow write: if isAdmin();
    }
    match /annualReports/{id} {
      allow read: if canReadBusinessData();
      allow write: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
